# Copy to frontend/.env. Restart Expo for API URL changes; rebuild Android for Maps key changes.
# Only the API URL is public. Gemini and backend Maps keys belong in backend/.env.

# FastAPI backend (see ../backend/README.md). localhost is rewritten to the dev machine on devices and emulators.
EXPO_PUBLIC_API_URL=http://localhost:8000
# Clear EXPO_PUBLIC_API_URL to use the built-in offline planner without the backend.
# On a physical phone, use the computer's reachable LAN IP if automatic detection fails.

# Clerk publishable key (Clerk Dashboard > API keys). It is public by design; the secret key belongs in backend/.env.
# Required: the app shows sign-in or guest mode based on the Clerk session.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Android map-display key for your own native build; iOS uses Apple Maps.
# Enable Maps SDK for Android + billing, and restrict by package name + signing SHA-1.
# This key is embedded in the Android build; rebuild after changing it.
# Run npm run android to build/install the app using this value (Expo Go uses its own key).
# Android package: com.yuancx2025.wayfare. Add the build's signing SHA-1 in Google Cloud.
# The web app uses a map fallback and does not need a Maps JavaScript API key.
GOOGLE_MAPS_ANDROID_KEY=
