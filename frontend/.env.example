# Copy to frontend/.env.local. Restart Expo after changing this file.
# Only the API URL is public. Gemini and backend Maps keys belong in backend/.env.

# FastAPI backend (see ../backend/README.md). localhost is rewritten to the dev machine on devices and emulators.
EXPO_PUBLIC_API_URL=http://localhost:8000
# Clear EXPO_PUBLIC_API_URL to use the built-in offline planner without the backend.
# On a physical phone, use the computer's reachable LAN IP if automatic detection fails.

# Optional SEPARATE Android map-display key for your own native build; iOS uses Apple Maps.
# Enable Maps SDK for Android + billing, and restrict by package name + signing SHA-1.
# This key is embedded in the Android build; rebuild after changing it.
# The web app uses a map fallback and does not need a Maps JavaScript API key.
GOOGLE_MAPS_ANDROID_KEY=
