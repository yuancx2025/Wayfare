# Copy to backend/.env and run backend commands from the backend directory.
# Keep server secrets here, never in EXPO_PUBLIC_* variables or version control.
# Blank Maps and LLM keys keep the bundled places catalog and the heuristic planner.

# Gemini Developer API: create a separate key in https://aistudio.google.com/api-keys.
# Set GOOGLE_API_KEY, then change LLM_MODEL to google_genai:gemini-3.5-flash-lite.
# GOOGLE_API_KEY is the Gemini key; it is NOT the Google Maps Platform key.
GOOGLE_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=1.0
GOOGLE_GENAI_USE_VERTEXAI=false

# Google Maps Platform SERVER key: enable Places API (New) and Routes API + billing.
# Restrict to those APIs and the server's public outbound IP where practical.
# Provides city autocomplete, attractions/restaurants, place details/photos, and travel routes.
GOOGLE_MAPS_API_KEY=

# Clerk (Dashboard > API keys). Keep these server-side only.
# CLERK_ISSUER is the Frontend API URL shown on the same page.
# CLERK_JWT_KEY is the "JWKS Public Key" (PEM); keep the quotes and \n line breaks so it fits on one line.
CLERK_SECRET_KEY=sk_test_...
CLERK_ISSUER=https://your-app.clerk.accounts.dev
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# Only needed for Expo web: the browser origins allowed to send tokens.
# CLERK_AUTHORIZED_PARTIES=["http://localhost:8081"]

# Direct (non-pooled) Neon URL. The hostname must not contain -pooler.
# postgres:// URLs are rewritten to postgresql+psycopg://. Keep Neon's sslmode=require.
DATABASE_URL=postgresql://user:pass@ep-example.c-13.us-east-1.aws.neon.tech/wayfare?sslmode=require
# Disposable database for pytest. The name must end with _test and must not be DATABASE_URL.
TEST_DATABASE_URL=postgresql://user:pass@ep-example.c-13.us-east-1.aws.neon.tech/wayfare_test?sslmode=require
# SEED_DEMO_TRIP=true

# Create tables once the database exists: uv run python -m app.bootstrap.db init --seed
# For browser access, use the actual Expo web origin if restricting CORS.
# CORS_ORIGINS=["http://localhost:8081"]
# GENERATION_TIMEOUT_S=60
# CURATE_MAX_RETRIES=2
